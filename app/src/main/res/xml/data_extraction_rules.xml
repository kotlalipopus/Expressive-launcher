<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила переноса данных для Android 12+. Раскладка не переносится: идентификаторы виджетов в layout.json
    привязаны к устройству, на другом телефоне они недействительны. Перенос раскладки между устройствами —
    через «Резервная копия» в настройках лаунчера.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="layout.json" />
        <exclude domain="file" path="layout.json.bak" />
        <exclude domain="file" path="layout.json.tmp" />
        <exclude domain="sharedpref" path="layout_meta.xml" />
        <exclude domain="sharedpref" path="plugin_approvals.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="layout.json" />
        <exclude domain="file" path="layout.json.bak" />
        <exclude domain="file" path="layout.json.tmp" />
        <exclude domain="sharedpref" path="layout_meta.xml" />
        <exclude domain="sharedpref" path="plugin_approvals.xml" />
    </device-transfer>
</data-extraction-rules>
