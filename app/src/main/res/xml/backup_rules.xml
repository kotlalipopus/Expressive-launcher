<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила автобэкапа для Android 11 и ниже. Раскладка не переносится: идентификаторы виджетов в layout.json
    привязаны к устройству, на другом телефоне они недействительны, и на столе оставались бы пустые места.
    Перенос раскладки между устройствами — через «Резервная копия» в настройках лаунчера.
-->
<full-backup-content>
    <exclude domain="file" path="layout.json" />
    <exclude domain="file" path="layout.json.bak" />
    <exclude domain="file" path="layout.json.tmp" />
    <exclude domain="sharedpref" path="layout_meta.xml" />
    <exclude domain="sharedpref" path="plugin_approvals.xml" />
</full-backup-content>
